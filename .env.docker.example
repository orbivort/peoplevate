# Peoplevate — Docker Compose environment variables.
#
# Copy this file to `.env` (monorepo root) and replace ALL secrets before the
# first `docker compose up`. docker-compose.yml reads these values.
#
#   cp .env.docker.example .env
#   # then edit .env
#
# Security: never commit .env. Use strong random values for every secret.
#   JWT_SECRET:            openssl rand -hex 32
#   FIELD_ENCRYPTION_KEY:  openssl rand -hex 32

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=peoplevate
POSTGRES_USER=peoplevate
# REQUIRED — change this to a strong password.
POSTGRES_PASSWORD=change-me-strong-password
# Host port for the database. Bound to localhost only. Set to blank to disable
# host access entirely (recommended for security).
POSTGRES_PORT=5432

# ---- Application ports ------------------------------------------------------
# Public entrypoint (Nginx). Set 8080 if 80 is already in use.
APP_PORT=80
# Optional direct API access from the host (localhost only). Set blank to disable.
BACKEND_PORT=4000

# ---- Frontend ---------------------------------------------------------------
# CORS origin for browser requests. Use your public URL if behind a domain.
CORS_ORIGIN=http://localhost

# ---- Secrets (REQUIRED, >= 32 chars each) -----------------------------------
JWT_SECRET=replace-with-openssl-rand-hex-32-at-least-32-chars
FIELD_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-at-least-32-chars

# ---- JWT lifetime -----------------------------------------------------------
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email delivery strategy -------------------------------------------------
#   real — deliver via SMTP using the SMTP_* variables below (production).
#   mock — deliver to an in-process mailbox with zero network I/O (dev/test).
EMAIL_MODE=real

# ---- SMTP (email) -----------------------------------------------------------
# Leave SMTP_HOST=localhost if you do not need outbound email yet.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@peoplevate.local

# ---- File uploads -----------------------------------------------------------
MAX_FILE_SIZE_MB=25

# ---- Logs --------------------------------------------------------------------
# Directory (inside the backend container) for log files such as email.log.
# Map it to a host path or named volume if you want to persist logs across
# container restarts.
LOG_DIR=./logs

# ---- GDPR / retention -------------------------------------------------------
TERMINATED_RECORD_RETENTION_YEARS=7
