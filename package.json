{
  "name": "peoplevate",
  "version": "1.0.2",
  "private": true,
  "description": "Peoplevate — an open-source Employee Lifecycle Management System covering recruitment, onboarding, attendance & leave, performance, offboarding, RBAC, and audit logging.",
  "license": "Apache-2.0",
  "author": "Orbivort",
  "repository": {
    "type": "git",
    "url": "https://github.com/orbivort/peoplevate.git"
  },
  "keywords": [
    "hr",
    "employee-lifecycle",
    "recruitment",
    "onboarding",
    "attendance",
    "leave",
    "performance-management",
    "offboarding",
    "rbac",
    "audit"
  ],
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^24.19.0",
    "pnpm": "^11.21.0"
  },
  "engine-strict": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter=@peoplevate/backend run dev\" \"pnpm --filter=@peoplevate/frontend run dev\"",
    "dev:test": "concurrently \"pnpm --filter=@peoplevate/backend run dev:test\" \"pnpm --filter=@peoplevate/frontend run dev:test\"",
    "dev:frontend": "pnpm --filter @peoplevate/frontend dev",
    "dev:backend": "pnpm --filter @peoplevate/backend dev",
    "build": "pnpm --filter @peoplevate/frontend build && pnpm --filter @peoplevate/backend build",
    "preview": "pnpm --filter @peoplevate/frontend preview",
    "typecheck": "pnpm --filter @peoplevate/frontend typecheck && pnpm --filter @peoplevate/backend typecheck",
    "lint": "pnpm --filter @peoplevate/frontend lint && pnpm --filter @peoplevate/backend lint",
    "lint:fix": "pnpm --filter @peoplevate/frontend lint:fix && pnpm --filter @peoplevate/backend lint:fix",
    "lint:css": "pnpm --filter @peoplevate/frontend lint:css",
    "lint:css:fix": "pnpm --filter @peoplevate/frontend lint:css:fix",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/*/eslint.config.js\" \".prettierrc\" \"packages/*/.stylelintrc.json\" \"package.json\" \"pnpm-workspace.yaml\"",
    "format:write": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/*/eslint.config.js\" \".prettierrc\" \"packages/*/.stylelintrc.json\" \"package.json\" \"pnpm-workspace.yaml\"",
    "db:generate": "pnpm --filter @peoplevate/backend db:generate",
    "db:migrate": "pnpm --filter @peoplevate/backend db:migrate",
    "db:migrate:test": "pnpm --filter @peoplevate/backend db:migrate:test",
    "db:push": "pnpm --filter @peoplevate/backend db:push",
    "db:seed": "pnpm --filter @peoplevate/backend db:seed",
    "db:seed:test": "pnpm --filter @peoplevate/backend db:seed:test",
    "db:studio": "pnpm --filter @peoplevate/backend db:studio",
    "audit": "pnpm audit --registry https://registry.npmjs.org/",
    "outdated": "pnpm outdated --recursive",
    "clean": "pnpm -r --parallel run clean",
    "postclean": "rimraf coverage .turbo node_modules",
    "clean:all": "pnpm -r --parallel run clean:all",
    "postclean:all": "rimraf packages/backend/node_modules packages/frontend/node_modules packages/config/eslint/node_modules packages/config/vitest/node_modules packages/e2e/node_modules coverage .turbo node_modules",
    "test:frontend": "pnpm --filter @peoplevate/frontend test",
    "test:frontend:coverage": "pnpm --filter @peoplevate/frontend test:coverage",
    "test:backend": "pnpm --filter @peoplevate/backend test",
    "test:backend:coverage": "pnpm --filter @peoplevate/backend test:coverage",
    "test:backend:integration": "pnpm --filter @peoplevate/backend test:integration",
    "test:e2e": "pnpm --filter @peoplevate/e2e e2e",
    "test:e2e:install": "pnpm --filter @peoplevate/e2e install:browsers",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:integration": "pnpm --filter @peoplevate/backend test:integration",
    "test:typecheck": "pnpm --filter @peoplevate/backend test:typecheck && pnpm --filter @peoplevate/frontend typecheck:test",
    "test:coverage": "pnpm test:frontend:coverage && pnpm test:backend:coverage",
    "ci": "pnpm typecheck && pnpm test:typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm test:coverage"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3"
  }
}
