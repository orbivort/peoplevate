# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://peoplevate:peoplevate@localhost:5432/peoplevate?schema=public"

# JWT
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Password Policy
PASSWORD_MIN_LENGTH=8
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MIN=15

# Rate Limiting
LOGIN_RATE_LIMIT_PER_MIN=10

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Logs
# Directory for backend log files (email.log is written here). Created on
# startup and git-ignored.
LOG_DIR=./logs

# Token Expiry
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1
SETUP_TOKEN_EXPIRY_HOURS=24

# Email delivery strategy
#   real — deliver via SMTP using the SMTP_* variables below (production).
#   mock — deliver to an in-process mailbox with zero network I/O (dev/test).
EMAIL_MODE=real

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@peoplevate.local

# Cron
EXPIRY_CHECK_CRON_EXPRESSION="0 8 * * *"

# Data Retention
TERMINATED_RECORD_RETENTION_YEARS=7

# Performance: Probation cycle config
PROBATION_DEFAULT_MONTHS=3
PROBATION_CYCLE_CRON_EXPRESSION="0 5 * * *"
PROBATION_AHEAD_DAYS=14

# Encryption
FIELD_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-key-at-least-32-characters-long

# GDPR Compliance - Data Subject Rights
DSAR_SLA_DAYS=30
DSAR_REMINDER_DAYS=25
DPO_CONTACT_EMAIL=dpo@peoplevate.local

# GDPR Compliance - Data Minimization
IP_RETENTION_DAYS=90

# GDPR Compliance - Anomaly Detection
ANOMALY_FAILED_LOGIN_THRESHOLD=20
ANOMALY_FAILED_LOGIN_WINDOW_MINUTES=15
ANOMALY_BULK_DOWNLOAD_THRESHOLD=50
ANOMALY_BULK_DOWNLOAD_WINDOW_MINUTES=60

# GDPR Compliance - Retention Purge Cron
RETENTION_PURGE_CRON_EXPRESSION="0 4 * * *"

# GDPR Compliance - DSAR SLA Cron
DSAR_SLA_CRON_EXPRESSION="0 6 * * *"

# GDPR Compliance - Breach Escalation Cron
BREACH_ESCALATION_CRON_EXPRESSION="0 * * * *"
