{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The base config emits declarations; test files should only be type-checked.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": null,
    // Match the globs Vitest runs so `pnpm test:typecheck` type-checks exactly
    // what runs, plus the Vitest config itself (parity with the frontend).
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/test",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
