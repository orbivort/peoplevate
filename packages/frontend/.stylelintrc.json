{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-deprecated": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["theme", "utility", "variant", "custom-variant", "source"]
      }
    ],
    "import-notation": "string",
    "no-descending-specificity": null
  }
}
