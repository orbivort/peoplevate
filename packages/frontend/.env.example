# Frontend environment configuration (Vite)
#
# Copy this file to `.env.local` and adjust values as needed.
# All variables exposed to the browser must start with the `VITE_` prefix.

# --- Data source switch -----------------------------------------------------
# Mock mode is an explicit opt-in. Only the exact value 'true' enables it.
#   'true'  -> mock mode. HTTP requests are intercepted at the network layer by
#              MSW and answered from the in-memory mock store (seeded from
#              src/data/mock-data.ts). Login is simulated, no backend required.
#   unset / 'false' / anything else -> API mode. The frontend talks to the real
#              backend over HTTP. You must keep the backend running
#              (packages/backend) and, in dev, the Vite proxy below must point
#              at the correct backend port.
VITE_USE_MOCK=true

# --- Backend API (only used when VITE_USE_MOCK=false) -----------------------
# Optional. Defaults to the same-origin path (''), so API requests are sent to
# /api/... . In development the Vite dev proxy rewrites '/api' to the backend.
VITE_API_BASE=

# Vite dev-server proxy target for '/api' requests. Used by vite.config.ts.
# Defaults to http://localhost:4000 (the backend port). Only read at server
# start, not exposed to the browser.
VITE_API_PROXY_TARGET=http://localhost:4000
