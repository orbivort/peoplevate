{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Test files are type-checked only; vitest/esbuild handle runtime execution.
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test",
    "vitest.config.ts"
  ]
}
