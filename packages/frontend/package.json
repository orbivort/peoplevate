{
  "name": "@peoplevate/frontend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "homepage": "https://orbivort.github.io/peoplevate/",
  "description": "Peoplevate frontend — React 19 + Vite SPA for the Employee Lifecycle Management System.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orbivort/peoplevate.git",
    "directory": "packages/frontend"
  },
  "keywords": [
    "react",
    "vite",
    "tailwindcss",
    "hr",
    "employee-lifecycle"
  ],
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "cross-env NODE_ENV=test vite --mode test",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "clean:all": "rimraf --verbose dist tsconfig.tsbuildinfo node_modules coverage .vite"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "formik": "^2.4.9",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@peoplevate/eslint-config": "workspace:*",
    "@peoplevate/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "catalog:",
    "jsdom": "^30.0.1",
    "msw": "^2.7.0",
    "postcss": "^8.5.25",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.2.0",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
