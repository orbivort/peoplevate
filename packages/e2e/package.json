{
  "name": "@peoplevate/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Peoplevate end-to-end tests — Playwright driven through a real browser against a real backend + seeded database.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install",
    "e2e": "node scripts/run-e2e.mjs",
    "clean": "rimraf test-results playwright-report",
    "clean:all": "rimraf --verbose test-results playwright-report node_modules"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^17.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
