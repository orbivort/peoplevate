# Peoplevate E2E environment.
# Copy to `.env` (in packages/e2e) and tweak as needed. These are read by the
# root `pnpm test:e2e` orchestration script and by the Playwright helpers.

# Frontend origin the browser navigates to.
E2E_BASE_URL=http://localhost:5173

# Backend origin the frontend proxies /api to.
E2E_API_URL=http://localhost:4000

# Postgres connection string for the E2E database. The backend is booted with
# DATABASE_URL pointing here, and tests reset it to a known seed between runs.
E2E_DB_URL=postgresql://peoplevate:peoplevate@localhost:5432/peoplevate_e2e?schema=public
